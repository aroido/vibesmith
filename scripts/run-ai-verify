#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
VERIFY_HELPER="${CODEX_VERIFY_HELPER:-$HOME/bin/codex-ai-verify}"

cd "$ROOT_DIR"

if [[ -x "$VERIFY_HELPER" ]]; then
  exec "$VERIFY_HELPER" "$@"
fi

exec "$ROOT_DIR/scripts/ai-verify" "$@"
