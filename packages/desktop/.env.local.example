# Apple Developer Credentials for Code Signing & Notarization
# 
# 이 파일을 .env.local로 복사하고 실제 값을 입력하세요.
# .env.local은 .gitignore에 포함되어 있어 커밋되지 않습니다.

# Apple ID (개발자 계정 이메일)
APPLE_ID=your.email@example.com

# App-Specific Password (appleid.apple.com에서 생성)
# https://appleid.apple.com → Sign-In and Security → App-Specific Passwords
APPLE_ID_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Team ID (developer.apple.com → Membership에서 확인)
# 예: ABC123XYZ
APPLE_TEAM_ID=YOUR_TEAM_ID

# PostHog Analytics (optional)
# PostHog 프로젝트 API Key (Project Settings > Project API Key)
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostHog 수집 호스트 (Cloud US 기본값)
# EU 사용 시: https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
