{
  "name": "@vibesmith/desktop",
  "version": "0.5.4-alpha.17",
  "description": "VibeSmith Desktop App (Electron)",
  "main": "out/main/main.js",
  "author": "VibeSmith Contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:internal": "VIBESMITH_BUILD_FLAVOR=internal electron-vite dev",
    "build": "electron-vite build",
    "build:api-executable": "cd ../api && python3 build_api_executable.py",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "pack:internal": "node scripts/dist-mac-internal.cjs dir",
    "pack:internal:unsigned": "VIBESMITH_INTERNAL_SIGN=never node scripts/dist-mac-internal.cjs dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:zip": "npm run build && electron-builder --mac zip",
    "dist:mac:dmg": "npm run build && electron-builder --mac dmg",
    "dist:mac:internal": "node scripts/dist-mac-internal.cjs zip",
    "dist:mac:internal:unsigned": "VIBESMITH_INTERNAL_SIGN=never node scripts/dist-mac-internal.cjs zip",
    "dist:mac:internal:dmg": "node scripts/dist-mac-internal.cjs dmg",
    "dist:mac:internal:dmg:unsigned": "VIBESMITH_INTERNAL_SIGN=never node scripts/dist-mac-internal.cjs dmg",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:readiness": "rm -rf .tmp-test-build && tsc -p tsconfig.json --outDir .tmp-test-build && node --test tests/*.test.cjs && rm -rf .tmp-test-build",
    "test:e2e:desktop": "npm run build:api-executable && VIBESMITH_POSTHOG_ALLOW_WEBDRIVER=true npm run build && playwright test -c playwright.desktop.config.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint electron --ext ts --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@tanstack/react-query": "^5.90.21",
    "@vibesmith/web": "file:../web",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "i18next": "^25.8.10",
    "posthog-js": "^1.362.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.13.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^3.1.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^36.9.5",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "eslint": "^8.57.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.3",
    "vite": "^5.1.0"
  },
  "keywords": [
    "electron",
    "desktop",
    "vibesmith",
    "ai",
    "cursor",
    "claude"
  ]
}
