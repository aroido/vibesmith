{
  "fields": [
    {
      "name": "skill_name",
      "label": "스킬 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: my-custom-skill",
      "validation": {"pattern": "^[a-z0-9-]+$", "min_length": 3, "max_length": 50}
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "validation": {"min_length": 10, "max_length": 500}
    },
    {
      "name": "tools",
      "label": "허용 도구",
      "type": "multiselect",
      "required": false,
      "options": ["read", "write", "shell", "search", "browser"],
      "default": ["read", "write"]
    },
    {
      "name": "context",
      "label": "컨텍스트",
      "type": "multiselect",
      "required": false,
      "options": ["project_structure", "git_history", "dependencies"],
      "default": ["project_structure"]
    }
  ]
}
