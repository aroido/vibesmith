{
  "fields": [
    {
      "name": "skill_name",
      "label": "스킬 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: api-doc-generator",
      "validation": {"pattern": "^[a-z0-9-]+$", "min_length": 3, "max_length": 50}
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "validation": {"min_length": 10, "max_length": 500}
    },
    {
      "name": "doc_format",
      "label": "문서 형식",
      "type": "select",
      "required": true,
      "options": ["markdown", "jsdoc", "docstring", "openapi"],
      "default": "markdown"
    },
    {
      "name": "include_examples",
      "label": "예시 포함",
      "type": "checkbox",
      "required": false,
      "default": true,
      "help_text": "코드 예시를 문서에 포함할지 여부"
    },
    {
      "name": "tools",
      "label": "허용 도구",
      "type": "multiselect",
      "required": false,
      "options": ["read", "write", "search"],
      "default": ["read", "write"]
    }
  ]
}
