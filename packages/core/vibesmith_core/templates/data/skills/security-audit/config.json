{
  "fields": [
    {
      "name": "skill_name",
      "label": "스킬 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: security-scanner",
      "validation": {"pattern": "^[a-z0-9-]+$", "min_length": 3, "max_length": 50}
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "validation": {"min_length": 10, "max_length": 500}
    },
    {
      "name": "audit_scope",
      "label": "감사 범위",
      "type": "multiselect",
      "required": true,
      "options": ["sql-injection", "xss", "csrf", "auth", "secrets", "dependencies"],
      "default": ["sql-injection", "xss", "auth"]
    },
    {
      "name": "severity_threshold",
      "label": "심각도 임계값",
      "type": "select",
      "required": false,
      "options": ["critical", "high", "medium", "low"],
      "default": "high"
    },
    {
      "name": "tools",
      "label": "허용 도구",
      "type": "multiselect",
      "required": false,
      "options": ["read", "search", "shell"],
      "default": ["read", "search"]
    }
  ]
}
