{
  "fields": [
    {
      "name": "skill_name",
      "label": "스킬 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: docker-deploy-helper",
      "validation": {"pattern": "^[a-z0-9-]+$", "min_length": 3, "max_length": 50}
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "validation": {"min_length": 10, "max_length": 500}
    },
    {
      "name": "platform",
      "label": "플랫폼",
      "type": "select",
      "required": true,
      "options": ["docker", "kubernetes", "aws", "github-actions", "terraform"],
      "default": "docker"
    },
    {
      "name": "automation_type",
      "label": "자동화 타입",
      "type": "multiselect",
      "required": false,
      "options": ["build", "test", "deploy", "monitoring", "backup"],
      "default": ["build", "deploy"]
    },
    {
      "name": "tools",
      "label": "허용 도구",
      "type": "multiselect",
      "required": false,
      "options": ["read", "write", "shell"],
      "default": ["read", "write", "shell"]
    }
  ]
}
