{
  "fields": [
    {
      "name": "skill_name",
      "label": "스킬 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: security-code-reviewer",
      "validation": {
        "pattern": "^[a-z0-9-]+$",
        "min_length": 3,
        "max_length": 50
      }
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "placeholder": "코드 리뷰 스킬을 설명하세요",
      "validation": {
        "min_length": 10,
        "max_length": 500
      }
    },
    {
      "name": "review_focus",
      "label": "리뷰 초점",
      "type": "multiselect",
      "required": true,
      "options": ["security", "performance", "code-quality", "best-practices", "accessibility"],
      "default": ["security", "code-quality"],
      "help_text": "리뷰 시 중점적으로 확인할 영역"
    },
    {
      "name": "severity_level",
      "label": "심각도 수준",
      "type": "select",
      "required": false,
      "options": ["all", "critical", "high", "medium"],
      "default": "all",
      "help_text": "보고할 최소 심각도 수준"
    },
    {
      "name": "tools",
      "label": "허용 도구",
      "type": "multiselect",
      "required": false,
      "options": ["read", "search"],
      "default": ["read", "search"]
    }
  ]
}
