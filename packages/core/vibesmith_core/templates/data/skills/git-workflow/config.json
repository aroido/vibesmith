{
  "fields": [
    {
      "name": "skill_name",
      "label": "스킬 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: git-commit-helper",
      "validation": {"pattern": "^[a-z0-9-]+$", "min_length": 3, "max_length": 50}
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "validation": {"min_length": 10, "max_length": 500}
    },
    {
      "name": "workflow_type",
      "label": "워크플로우 타입",
      "type": "select",
      "required": true,
      "options": ["commit-message", "branch-naming", "pr-description", "changelog"],
      "default": "commit-message"
    },
    {
      "name": "convention",
      "label": "컨벤션",
      "type": "select",
      "required": false,
      "options": ["conventional-commits", "semantic", "custom"],
      "default": "conventional-commits"
    },
    {
      "name": "tools",
      "label": "허용 도구",
      "type": "multiselect",
      "required": false,
      "options": ["read", "shell", "search"],
      "default": ["read", "shell"]
    }
  ]
}
