{
  "fields": [
    {
      "name": "skill_name",
      "label": "스킬 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: db-migration-helper",
      "validation": {"pattern": "^[a-z0-9-]+$", "min_length": 3, "max_length": 50}
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "validation": {"min_length": 10, "max_length": 500}
    },
    {
      "name": "db_type",
      "label": "데이터베이스 타입",
      "type": "select",
      "required": true,
      "options": ["postgresql", "mysql", "sqlite", "mongodb"],
      "default": "postgresql"
    },
    {
      "name": "migration_tool",
      "label": "마이그레이션 도구",
      "type": "select",
      "required": true,
      "options": ["alembic", "flyway", "liquibase", "raw-sql"],
      "default": "alembic"
    },
    {
      "name": "tools",
      "label": "허용 도구",
      "type": "multiselect",
      "required": false,
      "options": ["read", "write", "shell"],
      "default": ["read", "write", "shell"]
    }
  ]
}
