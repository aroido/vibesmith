{
  "fields": [
    {
      "name": "skill_name",
      "label": "스킬 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: pytest-helper",
      "help_text": "스킬을 식별할 고유한 이름을 입력하세요",
      "validation": {
        "pattern": "^[a-z0-9-]+$",
        "message": "소문자, 숫자, 하이픈만 사용 가능합니다",
        "min_length": 3,
        "max_length": 50
      }
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "placeholder": "이 스킬이 하는 일을 설명하세요",
      "help_text": "AI 에이전트가 이 스킬의 목적을 이해할 수 있도록 명확하게 작성하세요",
      "validation": {
        "min_length": 10,
        "max_length": 500
      }
    },
    {
      "name": "tools",
      "label": "허용 도구",
      "type": "multiselect",
      "required": false,
      "options": ["read", "write", "shell", "search", "browser"],
      "default": ["read", "write"],
      "help_text": "이 스킬이 사용할 수 있는 도구를 선택하세요"
    },
    {
      "name": "context",
      "label": "컨텍스트",
      "type": "multiselect",
      "required": false,
      "options": ["project_structure", "git_history", "dependencies", "test_files"],
      "default": ["project_structure"],
      "help_text": "AI 에이전트에게 제공할 컨텍스트를 선택하세요"
    },
    {
      "name": "custom_instructions",
      "label": "커스텀 지침",
      "type": "textarea",
      "required": false,
      "placeholder": "추가적인 지침을 입력하세요 (선택)",
      "help_text": "특별한 규칙이나 지침이 있다면 여기에 작성하세요"
    },
    {
      "name": "example_code",
      "label": "예시 코드",
      "type": "textarea",
      "required": false,
      "placeholder": "예시 코드를 입력하세요 (선택)",
      "help_text": "이 스킬의 사용 예시를 보여주는 코드를 작성하세요"
    }
  ]
}
