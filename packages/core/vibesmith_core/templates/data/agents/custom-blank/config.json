{
  "fields": [
    {
      "name": "agent_name",
      "label": "에이전트 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: my-custom-agent",
      "validation": {"pattern": "^[a-z0-9-]+$", "min_length": 3, "max_length": 50}
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "validation": {"min_length": 10, "max_length": 500}
    },
    {
      "name": "skills",
      "label": "사용 스킬",
      "type": "multiselect",
      "required": false,
      "options": [],
      "default": [],
      "help_text": "이 에이전트가 사용할 스킬들"
    },
    {
      "name": "context",
      "label": "컨텍스트",
      "type": "multiselect",
      "required": false,
      "options": ["project_structure", "git_history", "dependencies"],
      "default": ["project_structure"]
    }
  ]
}
