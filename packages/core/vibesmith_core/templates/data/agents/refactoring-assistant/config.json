{
  "fields": [
    {
      "name": "agent_name",
      "label": "에이전트 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: code-refactoring-assistant",
      "validation": {"pattern": "^[a-z0-9-]+$", "min_length": 3, "max_length": 50}
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "validation": {"min_length": 10, "max_length": 500}
    },
    {
      "name": "refactoring_goals",
      "label": "리팩토링 목표",
      "type": "multiselect",
      "required": true,
      "options": ["reduce-complexity", "improve-readability", "eliminate-duplication", "improve-performance", "modernize-code"],
      "default": ["reduce-complexity", "improve-readability"]
    },
    {
      "name": "preserve_behavior",
      "label": "동작 보존",
      "type": "checkbox",
      "required": false,
      "default": true,
      "help_text": "리팩토링 시 기존 동작을 보존할지 여부"
    },
    {
      "name": "run_tests_after",
      "label": "테스트 실행",
      "type": "checkbox",
      "required": false,
      "default": true,
      "help_text": "리팩토링 후 테스트를 자동 실행할지 여부"
    },
    {
      "name": "skills",
      "label": "사용 스킬",
      "type": "multiselect",
      "required": false,
      "options": ["code-review", "test-writer"],
      "default": []
    }
  ]
}
