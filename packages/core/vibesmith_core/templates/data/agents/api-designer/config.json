{
  "fields": [
    {
      "name": "agent_name",
      "label": "에이전트 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: rest-api-designer",
      "validation": {"pattern": "^[a-z0-9-]+$", "min_length": 3, "max_length": 50}
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "validation": {"min_length": 10, "max_length": 500}
    },
    {
      "name": "api_style",
      "label": "API 스타일",
      "type": "select",
      "required": true,
      "options": ["rest", "graphql", "grpc"],
      "default": "rest"
    },
    {
      "name": "design_principles",
      "label": "설계 원칙",
      "type": "multiselect",
      "required": false,
      "options": ["restful", "resource-oriented", "versioned", "paginated", "filtered"],
      "default": ["restful", "versioned"]
    },
    {
      "name": "generate_spec",
      "label": "스펙 생성",
      "type": "select",
      "required": false,
      "options": ["openapi", "swagger", "none"],
      "default": "openapi"
    },
    {
      "name": "skills",
      "label": "사용 스킬",
      "type": "multiselect",
      "required": false,
      "options": ["documentation"],
      "default": ["documentation"]
    }
  ]
}
