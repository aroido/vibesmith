{
  "fields": [
    {
      "name": "agent_name",
      "label": "에이전트 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: auto-bug-fixer",
      "validation": {"pattern": "^[a-z0-9-]+$", "min_length": 3, "max_length": 50}
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "validation": {"min_length": 10, "max_length": 500}
    },
    {
      "name": "bug_sources",
      "label": "버그 소스",
      "type": "multiselect",
      "required": true,
      "options": ["test-failures", "linter-errors", "runtime-errors", "user-reports"],
      "default": ["test-failures", "linter-errors"]
    },
    {
      "name": "auto_fix_level",
      "label": "자동 수정 수준",
      "type": "select",
      "required": false,
      "options": ["safe-only", "moderate", "aggressive"],
      "default": "safe-only"
    },
    {
      "name": "create_tests",
      "label": "회귀 테스트 생성",
      "type": "checkbox",
      "required": false,
      "default": true
    },
    {
      "name": "skills",
      "label": "사용 스킬",
      "type": "multiselect",
      "required": false,
      "options": ["code-review", "test-writer"],
      "default": []
    }
  ]
}
