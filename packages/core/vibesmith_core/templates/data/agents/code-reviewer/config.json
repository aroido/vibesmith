{
  "fields": [
    {
      "name": "agent_name",
      "label": "에이전트 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: security-code-reviewer",
      "validation": {
        "pattern": "^[a-z0-9-]+$",
        "message": "소문자, 숫자, 하이픈만 사용 가능합니다",
        "min_length": 3,
        "max_length": 50
      }
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "validation": {
        "min_length": 10,
        "max_length": 500
      }
    },
    {
      "name": "review_scope",
      "label": "리뷰 범위",
      "type": "multiselect",
      "required": true,
      "options": ["security", "performance", "code-quality", "best-practices", "architecture"],
      "default": ["security", "code-quality"],
      "help_text": "리뷰 시 중점적으로 확인할 영역"
    },
    {
      "name": "auto_fix",
      "label": "자동 수정",
      "type": "checkbox",
      "required": false,
      "default": false,
      "help_text": "발견된 이슈를 자동으로 수정할지 여부"
    },
    {
      "name": "report_format",
      "label": "리포트 형식",
      "type": "select",
      "required": false,
      "options": ["markdown", "json", "html"],
      "default": "markdown"
    },
    {
      "name": "skills",
      "label": "사용 스킬",
      "type": "multiselect",
      "required": false,
      "options": ["code-review", "security-audit", "documentation"],
      "default": ["code-review"]
    }
  ]
}
