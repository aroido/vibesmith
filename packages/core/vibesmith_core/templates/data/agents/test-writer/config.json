{
  "fields": [
    {
      "name": "agent_name",
      "label": "에이전트 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: pytest-test-writer",
      "validation": {"pattern": "^[a-z0-9-]+$", "min_length": 3, "max_length": 50}
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "validation": {"min_length": 10, "max_length": 500}
    },
    {
      "name": "test_framework",
      "label": "테스트 프레임워크",
      "type": "select",
      "required": true,
      "options": ["pytest", "jest", "vitest", "unittest"],
      "default": "pytest"
    },
    {
      "name": "test_types",
      "label": "테스트 타입",
      "type": "multiselect",
      "required": false,
      "options": ["unit", "integration", "e2e", "performance"],
      "default": ["unit", "integration"]
    },
    {
      "name": "coverage_threshold",
      "label": "커버리지 목표 (%)",
      "type": "number",
      "required": false,
      "default": 80,
      "validation": {"min": 0, "max": 100}
    },
    {
      "name": "skills",
      "label": "사용 스킬",
      "type": "multiselect",
      "required": false,
      "options": ["api-testing", "react-testing"],
      "default": []
    }
  ]
}
