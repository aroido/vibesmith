{
  "fields": [
    {
      "name": "agent_name",
      "label": "에이전트 이름",
      "type": "text",
      "required": true,
      "placeholder": "예: perf-optimizer",
      "validation": {"pattern": "^[a-z0-9-]+$", "min_length": 3, "max_length": 50}
    },
    {
      "name": "description",
      "label": "설명",
      "type": "textarea",
      "required": true,
      "validation": {"min_length": 10, "max_length": 500}
    },
    {
      "name": "optimization_areas",
      "label": "최적화 영역",
      "type": "multiselect",
      "required": true,
      "options": ["algorithm", "database", "caching", "memory", "network"],
      "default": ["algorithm", "database"]
    },
    {
      "name": "performance_target",
      "label": "성능 목표",
      "type": "text",
      "required": false,
      "placeholder": "예: 응답시간 < 100ms"
    },
    {
      "name": "run_benchmarks",
      "label": "벤치마크 실행",
      "type": "checkbox",
      "required": false,
      "default": true
    },
    {
      "name": "skills",
      "label": "사용 스킬",
      "type": "multiselect",
      "required": false,
      "options": ["code-review"],
      "default": []
    }
  ]
}
