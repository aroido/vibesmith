{
  "name": "@vibesmith/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "VITE_E2E_MOCK=true vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "npm run lint:boundaries && eslint . --report-unused-disable-directives --max-warnings 50",
    "lint:boundaries": "node scripts/check-feature-boundaries.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --ui --coverage",
    "test:contract": "node scripts/check-api-contract.js && vitest run src/mocks/__tests__/api-contract.test.ts",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "test:e2e:ui": "node scripts/run-playwright-e2e.mjs --ui",
    "test:a11y": "node scripts/run-playwright-e2e.mjs --grep @a11y",
    "test:a11y:ui": "node scripts/run-playwright-e2e.mjs --grep @a11y --ui",
    "check:i18n": "node scripts/check-i18n.js",
    "metrics:theme": "node scripts/theme-style-metrics.mjs",
    "check:theme": "MAX_HARDCODED_COLOR_CLASSES=0 MAX_DARK_VARIANTS=0 MAX_INLINE_COLOR_STYLES=0 node scripts/theme-style-metrics.mjs",
    "test:visual": "node scripts/run-playwright-e2e.mjs --grep visual",
    "test:visual:ui": "node scripts/run-playwright-e2e.mjs --grep visual --ui",
    "test:visual:update": "node scripts/run-playwright-e2e.mjs --grep visual --update-snapshots",
    "analyze": "vite build --mode analyze",
    "lighthouse": "lhci autorun --config=.lighthouserc.cjs",
    "lighthouse:open": "lhci autorun --config=.lighthouserc.cjs && open .lighthouseci/*/lhr-*.html",
    "perf": "npm run build && npm run lighthouse",
    "perf:open": "npm run build && npm run lighthouse:open",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "audit": "npm audit --production",
    "audit:fix": "npm audit fix",
    "audit:report": "npm audit --production --json > audit-report.json",
    "license-check": "npx license-checker --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0' --summary",
    "security": "npm run audit && npm run license-check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.22.0",
    "@types/dagre": "^0.7.53",
    "@uiw/react-md-editor": "^4.0.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-hierarchy": "^3.1.2",
    "dagre": "^0.8.5",
    "date-fns": "^4.1.0",
    "diff": "^8.0.3",
    "driver.js": "^1.4.0",
    "fuse.js": "^7.1.0",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.575.0",
    "marked": "^17.0.2",
    "prismjs": "^1.30.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-focus-lock": "^2.13.7",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^16.5.4",
    "react-joyride": "^2.9.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "react-syntax-highlighter": "^16.1.1",
    "react-use-wizard": "^2.3.0",
    "reactflow": "^11.11.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@eslint/js": "^9.19.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.42.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/diff": "^7.0.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.17",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "happy-dom": "^20.7.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^28.1.0",
    "msw": "^2.12.10",
    "postcss": "^8.4.35",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
