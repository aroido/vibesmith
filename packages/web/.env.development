# Mock API 설정 (완료된 API는 false로 변경)
# - Dependency Graph API: Fallback to mock (백엔드 미구현)
# - Project Detail API: 구현 완료 (#203 CLOSED)
# - Component Wizard API: 구현 완료 (#130 CLOSED)
# - Dashboard Stats API: 구현 완료
# - Trash API: Fallback to empty array (백엔드 미구현 #165)
VITE_USE_MOCK_API=false

# Real API base URL
# 개발 모드에서는 Vite proxy 사용 (CORS 방지)
# 프로덕션 빌드 시에만 절대 경로 사용
VITE_API_URL=

# 개발 모드에서 온보딩 투어 자동 스킵 (개발자 편의 기능)
VITE_SKIP_TOUR=true

# Team 기능은 Phase 2 전까지 기본 비활성화 (필요 시 true로 오버라이드)
VITE_ENABLE_TEAM_FEATURE=false
